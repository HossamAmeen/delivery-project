# Flash PWA build-time configuration (ADR-008). Copy to `.env.local` for local builds.
# Values are baked into the static bundle at `npm run build`; never put secrets here.

# Required for `npm run build` (production mode). Absolute origin of the API, no trailing slash.
# Server build: https://api.delivery.hossam-ameen.online
VITE_API_BASE_URL=

# Optional. Display/PWA name. Default: Flash
VITE_APP_NAME=Flash

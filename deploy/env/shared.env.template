# Flash — server application environment: ${DEPLOY_PATH}/shared/.env (0600, hossam). ADR-015/017.
# Rendered from deploy/env/shared.env.template by setup-server.sh ONLY IF ABSENT; never overwritten.
# __GENERATE__ values are replaced on the server with secrets.token_urlsafe(); they never leave it.
# Read by systemd (EnvironmentFile) and by the ops scripts' KEY=VALUE parser: no quotes, no spaces,
# no shell syntax. Names = backend/.env.example (Backend owns them).
# Not here on purpose: FLASH_NEW_USER_PASSWORD (command-only, stdin is used) and DJANGO_ENV_FILE (local/tests).

# --- Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=__GENERATE__
DEBUG=False
ALLOWED_HOSTS=${API_DOMAIN},127.0.0.1,localhost
LOG_LEVEL=INFO
LANGUAGE_CODE=en
TIME_ZONE=UTC

# --- Database (SQLite WAL, ADR-017)
DATABASE_URL=sqlite:///${DEPLOY_PATH}/shared/db/flash.sqlite3
DB_CONN_MAX_AGE=0

# --- Static / media (served by nginx from shared/)
STATIC_ROOT=${DEPLOY_PATH}/shared/static
MEDIA_ROOT=${DEPLOY_PATH}/shared/media

# --- CORS / CSRF / proxy (nginx is the single trusted hop and overwrites X-Forwarded-For)
CORS_ALLOWED_ORIGINS=https://${WEB_DOMAIN}
CSRF_TRUSTED_ORIGINS=https://${API_DOMAIN},https://${WEB_DOMAIN}
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
NUM_PROXIES=1

# --- HTTPS hardening (nginx redirects and sends HSTS; parent domain shared with dental)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- API docs (ADR-019: staff only in production)
API_DOCS_PUBLIC=False

# --- Pagination
API_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100

# --- JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=False

# --- Health API (header X-Health-Check-Token)
HEALTH_CHECK_PASSWORD=__GENERATE__

# --- Rate limiting
RATELIMIT_ANON=60/minute
RATELIMIT_USER=300/minute
RATELIMIT_AUTH=10/minute
RATELIMIT_SENSITIVE=30/minute
RATELIMIT_HEALTH=120/minute
RATELIMIT_CACHE_URL=filecache://${DEPLOY_PATH}/shared/cache

# --- Celery (disabled on the server, ADR-017)
CELERY_ENABLED=False
CELERY_BEAT_ENABLED=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
CELERY_WORKER_CONCURRENCY=2

# --- Deployment names (DRF_SKILL §8/§47; not read by Django)
DOMAIN=${API_DOMAIN}
BACKEND_PORT=${BACKEND_PORT}
FRONTEND_PORT=3000
BACKEND_PATH=${DEPLOY_PATH}/current/backend
FRONTEND_PATH=${DEPLOY_PATH}/current/frontend/dist
MEDIA_PATH=${DEPLOY_PATH}/shared/media
STATIC_PATH=${DEPLOY_PATH}/shared/static
SYSTEMD_SERVICE_NAME=${BACKEND_SYSTEMD_SERVICE}

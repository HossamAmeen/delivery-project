# Flash API site (${API_DOMAIN}) — FULL variant (TLS). ADR-015.
# Rendered by deploy/scripts/render-templates.sh (envsubst, explicit variable list). Do not edit on the server:
# it is replaced by the nginx safe-apply (write → nginx -t → reload, restore on failure).

# Access log without query strings: $uri only (never $request / $args / $request_uri), so a
# ?password= health token can never reach a log file.
log_format flash_api '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                     '$status $body_bytes_sent $request_time "$http_user_agent"';

server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};

    access_log /var/log/nginx/flash-api.access.log flash_api;
    error_log  /var/log/nginx/flash-api.error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl${NGINX_LISTEN_HTTP2};
    listen [::]:443 ssl${NGINX_LISTEN_HTTP2};
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # HSTS without includeSubDomains/preload: the parent domain is shared with dental (ADR-015).
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    access_log /var/log/nginx/flash-api.access.log flash_api;
    error_log  /var/log/nginx/flash-api.error.log warn;

    client_max_body_size 10m;

    location /static/ {
        alias ${DEPLOY_PATH}/shared/static/;
        expires 30d;
    }
    location /media/ {
        alias ${DEPLOY_PATH}/shared/media/;
    }
    location / {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_set_header Host $host;
        # Overwrite (never append): nginx is the single trusted hop (NUM_PROXIES=1, ADR-015).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_redirect off;
        # BUG-002: Django also sends X-Content-Type-Options; hide the upstream copy so the server-level
        # add_header below/above yields exactly one header (also on /static/, /media/ and nginx errors).
        proxy_hide_header X-Content-Type-Options;
        proxy_read_timeout 60s;
    }
}

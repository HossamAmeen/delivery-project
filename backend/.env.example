# Flash backend — application environment (DRF_SKILL §8, §78; ADR-012, ADR-015, ADR-017).
# Copy to backend/.env for local development. Never commit backend/.env.
# On the server these names are rendered into /srv/flash/shared/.env
# (deploy/env/shared.env.template); server values are shown in the comments.
# Keep the names stable: Infrastructure mirrors them.

# --- Django ---
# Server: config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development
# Server: generated on the server by setup-server.sh (ADR-015). Production refuses "change-me".
SECRET_KEY=change-me
# Server: False (production settings force DEBUG off anyway)
DEBUG=True
# Server: api.delivery.hossam-ameen.online,127.0.0.1,localhost
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: path of an env file to read instead of backend/.env (unset = backend/.env if it exists)
# DJANGO_ENV_FILE=
LOG_LEVEL=INFO
# Neutral defaults; final values pending BLK-009
LANGUAGE_CODE=en
TIME_ZONE=UTC

# --- Database (ADR-017: SQLite WAL on the server) ---
# Server: sqlite:////srv/flash/shared/db/flash.sqlite3
DATABASE_URL=sqlite:///db.sqlite3
# Ignored for SQLite (always 0); used for other engines
DB_CONN_MAX_AGE=600

# --- Static / media (served by nginx on the server) ---
# Server: /srv/flash/shared/static
STATIC_ROOT=./staticfiles
# Server: /srv/flash/shared/media
MEDIA_ROOT=./media

# --- CORS / CSRF / proxy (ADR-008, ADR-015) ---
# Server: https://delivery.hossam-ameen.online
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Server: https://api.delivery.hossam-ameen.online,https://delivery.hossam-ameen.online
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Server: HTTP_X_FORWARDED_PROTO,https   (empty = no trusted proxy header)
SECURE_PROXY_SSL_HEADER=
# DRF client-IP resolution: number of trusted proxies in X-Forwarded-For.
# Server: 1 (nginx overwrites X-Forwarded-For). Locally: leave empty.
NUM_PROXIES=

# --- HTTPS hardening (nginx redirects and sets HSTS on the server) ---
# Server: False
SECURE_SSL_REDIRECT=False
# Server: 0 (nginx sends HSTS)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Development only; production forces secure cookies
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- API docs (ADR-019) ---
# Development default True; production default False (staff only)
API_DOCS_PUBLIC=True

# --- Pagination ---
API_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=False

# --- Health API ---
# Server: generated on the server by setup-server.sh (ADR-015). Required in production.
HEALTH_CHECK_PASSWORD=change-me

# --- API Rate Limiting (DRF_SKILL §78) ---
RATELIMIT_ANON=60/minute
RATELIMIT_USER=300/minute
RATELIMIT_AUTH=10/minute
RATELIMIT_SENSITIVE=30/minute
RATELIMIT_HEALTH=120/minute

# --- Rate Limit Cache (ADR-017) ---
# locmem:// (single process / tests), filecache:///abs/path (shared by all
# gunicorn workers), redis://host:6379/2 (later). Production refuses locmem.
# Server: filecache:///srv/flash/shared/cache
RATELIMIT_CACHE_URL=locmem://

# --- Celery (optional; disabled on the server, ADR-017) ---
CELERY_ENABLED=False
CELERY_BEAT_ENABLED=False
# Redis DB layout when enabled: 0 broker, 1 results, 2 throttle cache
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
CELERY_WORKER_CONCURRENCY=2

# --- Management command create_role_user (ADR-018) ---
# Password for a new/updated user; prefer --password-stdin. Never put it in argv.
# FLASH_NEW_USER_PASSWORD=

# --- Deployment (DRF_SKILL §8/§47; NOT read by Django) ---
# The canonical deployment variables live in the repo-root .env.example
# (Infrastructure, ADR-012). Listed here for completeness with their ADR-012 names.
DOMAIN=api.delivery.hossam-ameen.online
# Server: 8010 (8000 belongs to the dental-clinic app)
BACKEND_PORT=8010
FRONTEND_PORT=3000
# ADR-012: ${DEPLOY_PATH}/current/backend
BACKEND_PATH=/srv/flash/current/backend
# ADR-012: ${DEPLOY_PATH}/current/frontend/dist
FRONTEND_PATH=/srv/flash/current/frontend/dist
# ADR-012: ${DEPLOY_PATH}/shared/media
MEDIA_PATH=/srv/flash/shared/media
# ADR-012: ${DEPLOY_PATH}/shared/static
STATIC_PATH=/srv/flash/shared/static
# ADR-012 name: BACKEND_SYSTEMD_SERVICE
SYSTEMD_SERVICE_NAME=flash-backend

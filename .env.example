# Flash — deployment variables (root .env). Copy to .env (git-ignored) and adjust.
# DEPLOYMENT variables only. NO application secrets here (ADR-015): SECRET_KEY and
# HEALTH_CHECK_PASSWORD are generated on the server into ${DEPLOY_PATH}/shared/.env and never leave it.

APP_NAME=flash
# systemd is the only implemented mode; docker is deferred (ADR-015) and exits with code 2.
DEPLOYMENT_MODE=systemd

# --- SSH target (the key is referenced by path and never printed)
SERVER_HOST=34.123.215.195
SERVER_USER=hossam
SERVER_PORT=22
SSH_KEY_PATH=~/.ssh/id_ed25519

# --- Layout / domains / service
DEPLOY_PATH=/srv/flash
API_DOMAIN=api.delivery.hossam-ameen.online
WEB_DOMAIN=delivery.hossam-ameen.online
BACKEND_PORT=8010
BACKEND_SYSTEMD_SERVICE=flash-backend

# --- Gunicorn / resource limits
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
BACKEND_MEMORY_MAX=700M

# --- Runtime (ADR-016): uv installed for SERVER_USER, pinned; Python managed by uv
PYTHON_VERSION=3.13
UV_VERSION=0.12.19

# --- Retention / deploy behaviour (ADR-013, ADR-015, ADR-017)
RELEASES_TO_KEEP=5
DB_BACKUPS_TO_KEEP=5
MIN_FREE_DISK_MB=1500
HEALTH_CHECK_TIMEOUT=60
AUTO_DEPLOY=false
AUTO_ROLLBACK=true
# auto | always | never
ROLLBACK_RESTORE_DB=auto

# --- TLS (TASK-013/014). The server already has a registered Let's Encrypt production ACME
# account; when LETSENCRYPT_EMAIL is empty, certbot reuses that account (no -m). Optional.
CERT_NAME=flash-delivery
LETSENCRYPT_EMAIL=

# --- nginx HTTP/2 on the Flash 443 listeners: on | off (default off, BLK-013).
# nginx 1.24 applies "http2" to the whole 443 socket, which dental-clinic shares, so "on" would also
# switch dental to HTTP/2 ("protocol options redefined" warning). Keep off until the TL decides.
NGINX_HTTP2=off

# --- Frontend build (local build machine)
VITE_API_BASE_URL=https://api.delivery.hossam-ameen.online

# --- Dental-clinic non-interference guard (ADR-015): read-only checks before/after every operation
DENTAL_GUARD_DOMAINS=dental.hossam-ameen.online,api.dental.hossam-ameen.online
DENTAL_GUARD_SERVICE=dental-clinic-backend
DENTAL_GUARD_PORT=8000
DENTAL_GUARD_PATH=/srv/dental-clinic
